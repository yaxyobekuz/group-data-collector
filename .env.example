# ── Telegram ──────────────────────────────────────────────
# @BotFather dan olinadi
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Owner Telegram ID — @userinfobot dan oling.
OWNER_ID=

# ── Ma'lumotlar bazasi ────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/school_monitor

# ── Vaqt zonasi ───────────────────────────────────────────
# "Shu kun" va cron jadvali shu zonaga bog'liq
TIMEZONE=Asia/Tashkent

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=
# nano — eng arzon model (chat matni ko'p bo'lgani uchun)
OPENAI_MODEL=gpt-5.4-nano

# ── Jadval (yakshanba yo'q: 1-6 = Dushanba-Shanba) ────────
# Kechasi 23:00 — vazifa yuborilganini tekshirish
HOMEWORK_CHECK_CRON=0 23 * * 1-6
# Ertalab 08:00 — adminlarga hisobot
REPORT_CRON=0 8 * * 1-6
# Dushanba 08:15 — o'qituvchilar haftalik reytingi
TEACHER_REPORT_CRON=15 8 * * 1

# Har yarim soatda — yangi muammo chiqsa adminlarga darhol xabar
QUICK_CHECK_CRON=*/30 * * * 1-6
# Jim soatlar: 07:00 dan oldin va 22:00 dan keyin xabar yuborilmaydi
QUIET_HOURS_END=7
QUIET_HOURS_START=22

# ── Rejim ─────────────────────────────────────────────────
BOT_MODE=polling
WEBHOOK_URL=https://example.com/telegram
WEBHOOK_SECRET=
PORT=8080
